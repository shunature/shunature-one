---
// src/components/BaseHead.astro
interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const { 
  title, 
  description = "shunatureによる、最速でソリッドな記録の場所。",
  ogImage = "/assets/favicon.svg" // Using SVG as default
} = Astro.props;

const siteTitle = title ? `${title} — swift-horse` : "swift-horse";
---

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  
  <!-- Favicons -->
  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
  <link rel="apple-touch-icon" href="/assets/favicon.svg" />
  
  <meta name="generator" content={Astro.generator} />
  
  <!-- Meta SEO -->
  <title>{siteTitle}</title>
  <meta name="description" content={description} />
  <meta name="author" content="利根川 駿" />

  <!-- OGP -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={siteTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={Astro.url} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:site_name" content="swift-house_from_shunature" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="fediverse:creator" content="@shunature@hogus.work" />

  <!-- RSS feed -->
  <link rel="alternate" type="application/rss+xml" title="swift-house_from_shunature" href="/feed.xml" />

  <!-- ── Anti-Flash Theme Injection ── -->
  <script is:inline>
    (function () {
      const saved = localStorage.getItem('theme');
      const dark  = window.matchMedia('(prefers-color-scheme: dark)').matches;
      const theme = saved || (dark ? 'dark' : 'light');
      document.documentElement.setAttribute('data-theme', theme);
    })();
  </script>
</head>
