---
// src/components/PortableTextImage.astro
import { urlFor } from '../lib/sanity'; // Ensure this exists or we'll define a quick helper

const { asset, alt, caption } = Astro.props.node;

const imageUrl = asset ? asset._ref : null;
// Simplified URL generator if you don't have urlFor yet
const src = imageUrl ? `https://cdn.sanity.io/images/mnubywum/production/${imageUrl.replace('image-', '').replace('-webp', '.webp').replace('-jpg', '.jpg').replace('-png', '.png')}` : null;
---

{src && (
  <figure class="portable-text-image">
    <img src={src} alt={alt || ''} loading="lazy" />
    {caption && <figcaption>{caption}</figcaption>}
  </figure>
)}

<style>
  .portable-text-image {
    margin: 2.5rem 0;
  }
  .portable-text-image img {
    width: 100%;
    height: auto;
    display: block;
  }
  figcaption {
    margin-top: 0.8rem;
    font-size: 0.8rem;
    color: var(--text-subtle);
    text-align: center;
    font-style: italic;
  }
</style>
