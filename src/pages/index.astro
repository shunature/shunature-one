---
import Layout from '../layouts/Layout.astro';
import NowPlaying from '../components/NowPlaying.astro';
import SpecialToast from '../components/SpecialToast.astro';
import { sanityClient } from '../lib/sanity';

interface Post {
  title: string;
  slug: string;
  date: string;
  tags?: string[];
  weather?: string;
  summary?: string;
}

// Fetch the top 12 latest posts from Sanity
let posts: Post[] = [];
try {
  posts = await sanityClient.fetch(`
    *[_type == "post"] | order(date desc) [0..11] {
      title,
      "slug": slug.current,
      date,
      tags,
      weather,
      summary
    }
  `);
} catch (e) {
  console.error("Failed to fetch posts from Sanity:", e);
}

// Helper to format date cleanly
const formatDate = (dateStr: string) => {
  const d = new Date(dateStr);
  return d.toLocaleDateString('ja-JP', { 
    year: 'numeric', 
    month: '2-digit', 
    day: '2-digit' 
  }).replace(/\//g, '.');
};
---

<Layout>
  <!-- Hero Section -->
  <section class="hero-section">
    <div class="hero-bg"></div>
    <div class="hero-content container">
      <span class="hero-eyebrow">shunature.one</span>
      <h1 class="hero-title title-serif">swift-horse<br />from_shunature</h1>
      <p class="hero-subtitle">Always_Chillout.</p>
      
      <!-- Live Last.fm widget -->
      <div class="hero-nowplaying">
        <NowPlaying variant="mini" />
      </div>
    </div>
  </section>

  <!-- Latest Blog Posts -->
  <section class="latest-section container-wide">
    <div class="latest-header">
      <h2 class="section-label">Latest</h2>
      <a href="/blog/" class="latest-more">すべて見る &rarr;</a>
    </div>

    {posts.length > 0 ? (
      <div class="post-list">
        {posts.map((post) => {
          const formattedDate = formatDate(post.date);
          return (
            <a href={`/blog/${post.slug}`} class="post-item">
              <div class="post-item-meta">
                <span class="post-item-date">{formattedDate}</span>
                {post.tags && post.tags.length > 0 && (
                  <span class="post-item-tag">{post.tags[0]}</span>
                )}
              </div>
              <div class="post-item-content">
                <h3 class="post-item-title">{post.title}</h3>
                {post.summary && <p class="post-item-desc">{post.summary}</p>}
              </div>
              <div class="post-item-arrow">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="7" y1="17" x2="17" y2="7"></line>
                  <polyline points="7 7 17 7 17 17"></polyline>
                </svg>
              </div>
            </a>
          );
        })}
      </div>
    ) : (
      <div class="empty-state">
        <p>記事が見つかりません。Sanity CMS にて記事を投稿するか、インポートスクリプトを実行してください。</p>
      </div>
    )}
  </section>

  <!-- Client-side special toasts -->
  <SpecialToast />
</Layout>

<style>
  /* ── Hero Section Layout ── */
  .hero-section {
    min-height: 80svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    position: relative;
    padding: 6rem 0;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: 
      radial-gradient(ellipse at 15% 75%, rgba(var(--accent-rgb), 0.07) 0%, transparent 55%),
      radial-gradient(ellipse at 85% 25%, rgba(var(--accent-rgb), 0.04) 0%, transparent 45%);
    z-index: 0;
  }

  .hero-content {
    position: relative;
    z-index: 1;
  }

  .hero-eyebrow {
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1.2rem;
    display: block;
    opacity: 0.85;
  }

  .hero-title {
    font-size: clamp(2.6rem, 8vw, 4.8rem);
    line-height: 1.1;
    letter-spacing: -0.01em;
    margin-bottom: 1.4rem;
    color: var(--text);
  }

  .hero-subtitle {
    font-size: 0.88rem;
    color: var(--text-muted);
    font-weight: 300;
    letter-spacing: 0.06em;
    margin-bottom: 2.5rem;
  }

  .hero-nowplaying {
    width: fit-content;
  }

  /* ── Latest Section ── */
  .latest-section {
    padding-bottom: 8rem;
  }

  .latest-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 0;
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.8rem;
  }

  .latest-more {
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    color: var(--text-subtle);
  }

  .latest-more:hover {
    color: var(--accent);
  }

  /* ── Post Grid (2-col) ── */
  .post-list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-left: 1px solid var(--border);
  }

  .post-item {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 1.8rem 1.5rem;
    border-right: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .post-item:hover {
    background: linear-gradient(135deg, rgba(var(--accent-rgb), 0.02) 0%, transparent 100%);
  }

  .post-item-meta {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    flex-shrink: 0;
  }

  .post-item-date {
    font-size: 0.72rem;
    color: var(--text-subtle);
    font-variant-numeric: tabular-nums;
    font-weight: 500;
  }

  .post-item-tag {
    font-size: 0.58rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    font-weight: 700;
    opacity: 0.8;
  }

  .post-item-content {
    flex: 1;
    min-width: 0;
  }

  .post-item-title {
    font-family: var(--font-serif);
    font-size: 1rem;
    font-weight: 500;
    color: var(--text);
    line-height: 1.4;
    margin-bottom: 0.3rem;
    transition: color 0.3s ease;
  }

  .post-item:hover .post-item-title {
    color: var(--accent);
  }

  .post-item-desc {
    font-size: 0.8rem;
    color: var(--text-muted);
    line-height: 1.6;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .post-item-arrow {
    color: var(--text-subtle);
    opacity: 0.2;
    transition: all 0.3s ease;
    flex-shrink: 0;
  }

  .post-item:hover .post-item-arrow {
    opacity: 1;
    color: var(--accent);
    transform: translate(2px, -2px);
  }

  /* Empty state */
  .empty-state {
    padding: 5rem 2rem;
    text-align: center;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text-subtle);
    font-size: 0.88rem;
    box-shadow: var(--shadow);
  }

  @media (max-width: 768px) {
    .post-list {
      grid-template-columns: 1fr;
    }
    .post-item {
      gap: 1rem;
    }
    .hero-section {
      min-height: 60svh;
      padding: 4rem 0;
    }
  }
</style>