---
import Layout from '../layouts/Layout.astro';
import NowPlaying from '../components/NowPlaying.astro';
---

<Layout title="Music">
  <div class="music-wrap container">

    <h1 class="music-title title-serif">Music</h1>

    <!-- Now Playing Section -->
    <div class="music-section">
      <div class="section-header">
        <h2 class="section-label">Now Playing</h2>
        <a href="/music/scrobbles/" class="section-link">View history &rarr;</a>
      </div>
      <NowPlaying variant="large" />
    </div>

    <!-- Playlists Section -->
    <div class="music-section">
      <div class="section-header">
        <h2 class="section-label">Playlists</h2>
      </div>
      <div class="playlist-list" id="playlists-grid">
        <p class="loading-text">読み込み中...</p>
      </div>
    </div>

  </div>
</Layout>

<style>
  .music-wrap {
    padding-top: 3.5rem;
    padding-bottom: 8rem;
  }

  .music-title {
    font-size: 1.8rem;
    font-weight: 500;
    margin-bottom: 3.5rem;
  }

  .music-section {
    margin-bottom: 4.5rem;
  }

  .section-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.8rem;
  }

  .section-link {
    font-size: 0.72rem;
    font-weight: 500;
    color: var(--text-subtle);
    transition: color 0.2s ease;
  }

  .section-link:hover {
    color: var(--accent);
  }

  /* ── Playlists ── */
  .playlist-list {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--border);
  }

  .playlist-item {
    display: flex;
    align-items: center;
    gap: 2.5rem;
    padding: 1.8rem 0;
    border-bottom: 1px solid var(--border);
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .playlist-item:hover {
    padding-left: 0.5rem;
    background: linear-gradient(90deg, rgba(var(--accent-rgb), 0.02) 0%, transparent 100%);
  }

  .playlist-info {
    flex: 1;
    min-width: 0;
  }

  .playlist-title {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-weight: 500;
    color: var(--text);
    line-height: 1.4;
    margin-bottom: 0.3rem;
    transition: color 0.3s ease;
  }

  .playlist-item:hover .playlist-title {
    color: var(--accent);
  }

  .playlist-desc {
    font-size: 0.82rem;
    color: var(--text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .playlist-arrow {
    color: var(--text-subtle);
    opacity: 0.2;
    transition: all 0.3s ease;
    flex-shrink: 0;
  }

  .playlist-item:hover .playlist-arrow {
    opacity: 1;
    color: var(--accent);
    transform: translate(2px, -2px);
  }

  .loading-text {
    font-size: 0.8rem;
    color: var(--text-subtle);
    opacity: 0.5;
    padding: 2rem 0;
  }
</style>

<script is:inline>
  (async function () {
    const grid = document.getElementById('playlists-grid');
    if (!grid) return;

    try {
      const playlists = await fetch('/music/playlists/list.json').then(r => r.json());

      if (!playlists || playlists.length === 0) {
        grid.innerHTML = '<p class="loading-text">プレイリストが見つかりません。</p>';
        return;
      }

      grid.innerHTML = playlists.map(pl => `
        <a href="${pl.url}" class="playlist-item" target="_blank" rel="noopener">
          <div class="playlist-info">
            <div class="playlist-title">${pl.title}</div>
            ${pl.description ? `<div class="playlist-desc">${pl.description}</div>` : ''}
          </div>
          <div class="playlist-arrow">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="7" y1="17" x2="17" y2="7"></line>
              <polyline points="7 7 17 7 17 17"></polyline>
            </svg>
          </div>
        </a>
      `).join('');
    } catch (e) {
      grid.innerHTML = '<p class="loading-text">読み込みに失敗しました。</p>';
    }
  })();
</script>