---
import Layout from '../../layouts/Layout.astro';
import { sanityClient } from '../../lib/sanity';
import { marked } from 'marked';
import { PortableText } from 'astro-portabletext';
import PortableTextImage from '../../components/PortableTextImage.astro';

const portableTextComponents = {
  type: {
    image: PortableTextImage,
  },
};

// TS Type definition
interface Post {
  title: string;
  slug: string;
  date: string;
  tags?: string[];
  thumbnail_credit?: string;
  thumbnail_credit_url?: string;
  weather?: string;
  summary?: string;
  body: string;
  content?: any;
}

interface RelatedPost {
  title: string;
  slug: string;
  date: string;
}

// SSG Path generator
export async function getStaticPaths() {
  try {
    const posts = await sanityClient.fetch(`*[_type == "post"] { "slug": slug.current }`);
    return posts.map((post: { slug: string }) => ({
      params: { slug: post.slug },
    }));
  } catch (e) {
    console.error("Failed to generate static paths:", e);
    return [];
  }
}

const { slug } = Astro.params;

// Query the complete post data matching slug
const post: Post = await sanityClient.fetch(`
  *[_type == "post" && slug.current == $slug][0] {
    title,
    "slug": slug.current,
    date,
    tags,
    thumbnail_credit,
    thumbnail_credit_url,
    weather,
    summary,
    body,
    content
  }
`, { slug });

if (!post) {
  return Astro.redirect('/404');
}

// Fetch 3 related posts (excluding the current one)
const relatedPosts: RelatedPost[] = await sanityClient.fetch(`
  *[_type == "post" && slug.current != $slug] | order(date desc) [0..2] {
    title,
    "slug": slug.current,
    date
  }
`, { slug });

// Parse Markdown body to HTML
const parsedBody = marked.parse(post.body || '', { breaks: true });

// Format dates nicely
const formatDate = (dateStr: string, options: Intl.DateTimeFormatOptions = { year: 'numeric', month: 'long', day: 'numeric' }) => {
  const d = new Date(dateStr);
  return d.toLocaleDateString('ja-JP', options);
};

const pageUrl = Astro.url.toString();
---

<Layout title={post.title} description={post.summary || post.title}>
  <article class="article-wrap">
    <div class="container">
      
      <!-- Back Link -->
      <a href="/blog/" class="article-back">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"/>
        </svg>
        Blog
      </a>

      <!-- Metadata Box -->
      <div class="article-meta">
        <span class="article-date">{formatDate(post.date)}</span>
        {post.weather && <span class="article-weather">{post.weather}</span>}
        <span class="article-author">shunature</span>
        {post.tags && post.tags.map(tag => (
          <a href={`/blog/?tag=${encodeURIComponent(tag)}`} class="article-tag">{tag}</a>
        ))}
      </div>

      <!-- Main Title -->
      <h1 class="article-title title-serif">{post.title}</h1>

      <!-- Compiles Content: Prefer Rich Text, fallback to Markdown -->
      <div class="article-body">
        {post.content ? (
          <PortableText value={post.content} components={portableTextComponents} />
        ) : (
          <div set:html={parsedBody} />
        )}
      </div>

      <!-- Post Footer (Share & Related drawer) -->
      <div class="article-footer">
        <!-- Dynamic Share button trays -->
        <div class="article-share">
          <span class="article-share-label">Share</span>
          <a 
            class="article-share-btn x-btn" 
            href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(pageUrl)}&text=${encodeURIComponent(post.title)}`} 
            target="_blank" 
            rel="noopener"
          >
            X
          </a>
          <a 
            class="article-share-btn misskey-btn" 
            href={`https://misskey.io/share?url=${encodeURIComponent(pageUrl)}&text=${encodeURIComponent(post.title)}`} 
            target="_blank" 
            rel="noopener"
          >
            Misskey
          </a>
          <button 
            class="article-share-btn copy-btn" 
            id="copy-link-btn"
            data-url={pageUrl}
          >
            Copy Link
          </button>
        </div>
        
        <!-- Related Drawer -->
        {relatedPosts.length > 0 && (
          <div class="article-related">
            <p class="related-section-label">Related Posts</p>
            <div class="article-related-grid">
              {relatedPosts.map(rel => {
                return (
                  <a href={`/blog/${rel.slug}`} class="article-related-card">
                    <div class="article-related-body">
                      <div class="article-related-title">{rel.title}</div>
                      <div class="article-related-date">{formatDate(rel.date, { year: 'numeric', month: '2-digit', day: '2-digit' }).replace(/\//g, '.')}</div>
                    </div>
                  </a>
                );
              })}
            </div>
          </div>
        )}
      </div>

    </div>
  </article>
</Layout>

<style>
  /* ── Layout & Margins ── */
  .article-wrap {
    padding-top: 3.5rem;
    padding-bottom: 8rem;
  }

  /* Optimize for no-image posts */
  .article-back + .article-title {
    margin-top: 1.5rem;
  }
  
  .article-back + .article-meta {
    margin-top: 1rem;
  }

  .article-back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.74rem;
    font-weight: 500;
    color: var(--text-subtle);
    margin-bottom: 2rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .article-back:hover {
    color: var(--accent);
  }

  /* ── Metadata ── */
  .article-meta {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin-bottom: 1.2rem;
    flex-wrap: wrap;
    font-size: 0.72rem;
    color: var(--text-subtle);
    font-weight: 500;
  }

  .article-date {
    font-variant-numeric: tabular-nums;
  }

  .article-weather {
    opacity: 0.85;
    background: var(--bg2);
    padding: 0.1rem 0.5rem;
    border-radius: var(--radius-sm);
    font-size: 0.68rem;
  }

  .article-author {
    opacity: 0.85;
  }

  .article-tag {
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    background: rgba(var(--accent-rgb), 0.05);
    border: 1px solid var(--border-mid);
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    font-weight: 600;
  }

  .article-tag:hover {
    background: var(--accent);
    color: #fff;
    box-shadow: 0 4px 10px rgba(var(--accent-rgb), 0.2);
  }

  /* ── Main Title ── */
  .article-title {
    font-size: clamp(1.6rem, 5vw, 2.3rem);
    line-height: 1.3;
    margin-bottom: 3.5rem;
    color: var(--text);
  }

  /* ── Post Footer Sharing ── */
  .article-footer {
    margin-top: 5rem;
    border-top: 1px solid var(--border-mid);
    padding-top: 3.5rem;
  }

  .article-share {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin-bottom: 4.5rem;
    flex-wrap: wrap;
  }

  .article-share-label {
    font-size: 0.68rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-subtle);
    font-weight: 600;
    margin-right: 0.4rem;
  }

  .article-share-btn {
    font-size: 0.72rem;
    font-weight: 500;
    border: 1px solid var(--border-mid);
    padding: 0.35rem 1rem;
    border-radius: 999px;
    cursor: pointer;
    background: var(--surface);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .article-share-btn:hover {
    color: var(--accent);
    border-color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(var(--accent-rgb), 0.1);
  }

  /* ── Related Drawer ── */
  .article-related {
    margin-top: 3rem;
  }

  .related-section-label {
    font-size: 0.68rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
    font-weight: 600;
    margin-bottom: 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .related-section-label::before {
    content: '';
    width: 4px;
    height: 4px;
    background-color: var(--accent);
    border-radius: 50%;
    box-shadow: 0 0 8px var(--accent);
  }

  .article-related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.5rem;
  }

  .article-related-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 0.8rem 1rem;
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    transition: all 0.3s ease;
  }

  .article-related-card:hover {
    border-color: var(--border-mid);
    background: var(--surface-hover);
    transform: translateY(-2px);
    box-shadow: 0 10px 25px -10px rgba(0, 0, 0, 0.08);
  }

  .article-related-body {
    min-width: 0;
  }

  .article-related-title {
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    line-height: 1.4;
  }

  .article-related-date {
    font-size: 0.65rem;
    color: var(--text-subtle);
    margin-top: 2px;
  }

  @media (max-width: 640px) {
    .article-meta {
      gap: 0.5rem;
    }
  }
</style>

<!-- Client Side Share Buttons Hydration -->
<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const copyBtn = document.getElementById('copy-link-btn');

    if (copyBtn) {
      copyBtn.addEventListener('click', () => {
        const url = copyBtn.getAttribute('data-url');
        
        navigator.clipboard.writeText(url).then(() => {
          const originalText = copyBtn.textContent;
          copyBtn.textContent = '✓ Copied';
          copyBtn.style.color = 'var(--accent)';
          copyBtn.style.borderColor = 'var(--accent)';

          setTimeout(() => {
            copyBtn.textContent = originalText;
            copyBtn.style.color = '';
            copyBtn.style.borderColor = '';
          }, 2000);
        }).catch(err => {
          console.error('Failed to copy link:', err);
        });
      });
    }
  });
</script>