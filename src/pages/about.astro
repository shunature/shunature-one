---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About">
  <div class="about-wrap container">
    
    <!-- Premium Interactive Tab Navigation -->
    <nav class="about-tabs" role="tablist">
      <button class="about-tab-btn active" id="tab-btn-me" data-tab="me" role="tab" aria-selected="true" aria-controls="panel-me">Me</button>
      <button class="about-tab-btn" id="tab-btn-links" data-tab="links" role="tab" aria-selected="false" aria-controls="panel-links">Links</button>
      <button class="about-tab-btn" id="tab-btn-sonech" data-tab="sonech" role="tab" aria-selected="false" aria-controls="panel-sonech">Sonech</button>
    </nav>

    <!-- ── Panel: Me ── -->
    <section class="about-panel active" id="panel-me" role="tabpanel" aria-labelledby="tab-btn-me">
      <!-- Profile Card -->
      <div class="about-section">
        <h2 class="section-label">Profile</h2>
        <div class="profile-card">
          <div class="profile-grid">
            <div class="profile-row"><span class="profile-key">Name</span><span class="profile-val">利根川 駿 / Shun Tonegawa</span></div>
            <div class="profile-row"><span class="profile-key">Handle</span><span class="profile-val">shunature</span></div>
            <div class="profile-row"><span class="profile-key">生年月日</span><span class="profile-val">2007年11月03日</span></div>
            <div class="profile-row"><span class="profile-key">出身地</span><span class="profile-val">埼玉県</span></div>
            <div class="profile-row"><span class="profile-key">職業</span><span class="profile-val">学生</span></div>
            <div class="profile-row"><span class="profile-key">利き手</span><span class="profile-val">左</span></div>
          </div>
          <p class="profile-bio">ちょびっと画像編集とベース演奏ができる人間です。</p>
        </div>
      </div>

      <!-- Names Card -->
      <div class="about-section">
        <h2 class="section-label">Names</h2>
        <div class="names-card">
          <div class="names-grid">
            <div class="name-row">
              <span class="name-category">本名</span>
              <div class="name-values">
                <span class="name-item">利根川 駿 <span class="name-en">Shun Tonegawa</span></span>
              </div>
            </div>
            <div class="name-row">
              <span class="name-category">ラジオネーム</span>
              <div class="name-values">
                <span class="name-item">薄味のキャルピス <span class="name-badge">FM</span></span>
                <span class="name-item">真紅の衝撃 <span class="name-badge">AM</span></span>
              </div>
            </div>
            <div class="name-row">
              <span class="name-category">ゲームネーム</span>
              <div class="name-values">
                <span class="name-item">クレスデュー</span>
                <span class="name-item">クレス</span>
                <span class="name-item">cresdew <span class="name-desc">crescent (三日月) + dew (夜露)</span></span>
                <span class="name-item">skywordscanbass <span class="name-badge">GPG</span></span>
              </div>
            </div>
            <div class="name-row">
              <span class="name-category">ID</span>
              <div class="name-values">
                <span class="name-item">shunature</span>
              </div>
            </div>
            <div class="name-row">
              <span class="name-category">ペンネーム</span>
              <div class="name-values">
                <span class="name-item"><a href="https://pixelfed.tokyo/shunature" target="_blank" rel="noopener">利根川 <span class="name-desc">三十五格子日記</span></a></span>
                <span class="name-item"><a href="https://www.reddit.com/user/Jealous_Local_550/" target="_blank" rel="noopener">ドトールのミルクティ <span class="name-desc">Reddit</span></a></span>
              </div>
            </div>
          </div>
          <p class="names-footnote">ゲームネームは文字数やプラットフォームによって使い分けています。</p>
        </div>
      </div>

      <!-- Contact Card -->
      <div class="about-section">
        <h2 class="section-label">Contact</h2>
        <div class="contact-card">
          <div class="contact-item">
            <span class="contact-label">運営へのご連絡 (サイト・その他)</span>
            <p class="contact-desc">管理人への気楽なメールに関しては、件名に「交流」と記載してください。</p>
            <p class="contact-desc">本サイトに関しては、件名に「shunature.oneについて」と記載してください。</p>
            
            <button class="contact-reveal-btn" id="reveal-email-btn">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                <polyline points="22,6 12,13 2,6"/>
              </svg>
              メールアドレスを表示
            </button>
            
            <div class="contact-revealed-wrap" id="email-revealed-wrap">
              <a href="mailto:contact@ffnet.work" class="contact-email">contact@ffnet.work</a>
              <button class="contact-copy-btn" id="copy-email-btn" data-email="contact@ffnet.work">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="9" y="9" width="13" height="13" rx="2"></rect>
                  <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                </svg>
                コピー
              </button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ── Panel: Links ── -->
    <section class="about-panel" id="panel-links" role="tabpanel" aria-labelledby="tab-btn-links">
      <h2 class="section-label">Links</h2>
      <div class="links-list">
        <div class="link-item">
          <a href="https://www.reddit.com/user/Jealous_Local_550/" target="_blank" rel="noopener">
            <span class="link-title">Reddit</span>
            <span class="link-note">暇になると見てます</span>
          </a>
          <span class="link-arrow">&nearr;</span>
        </div>
        <div class="link-item">
          <a href="https://discord.com/users/1469961720997875745" target="_blank" rel="noopener">
            <span class="link-title">Discord</span>
            <span class="link-note">連絡先としてどうぞ</span>
          </a>
          <span class="link-arrow">&nearr;</span>
        </div>
        <div class="link-item">
          <a href="https://mixi.social/@shunature" target="_blank" rel="noopener">
            <span class="link-title">mixi2</span>
            <span class="link-note">好きなこと語るときに使います</span>
          </a>
          <span class="link-arrow">&nearr;</span>
        </div>
        <div class="link-item">
          <a href="mailto:contact@ffnet.work">
            <span class="link-title">Email Contact</span>
            <span class="link-note">メールはこちらです</span>
          </a>
          <span class="link-arrow">&rarr;</span>
        </div>
      </div>
    </section>

    <!-- ── Panel: Sonech ── -->
    <section class="about-panel" id="panel-sonech" role="tabpanel" aria-labelledby="tab-btn-sonech">
      <!-- Sonech Overview -->
      <div class="about-section">
        <h2 class="section-label">Overview</h2>
        <div class="sonech-card prose-text">
          <p>このサイト（swift-horse / shunature.one）は、Anthropicが開発したAIアシスタント「Claude Sonnet 4.6」との協働により制作されました。</p>
          <p>コード設計・実装・デバッグのほか、構成の提案やデザインの方向性の検討においても活用しており、サイトの技術的基盤の大部分はClaudeとの対話を通じて構築されています。</p>
        </div>
      </div>

      <!-- Sonech Model Info -->
      <div class="about-section">
        <h2 class="section-label">Model Info</h2>
        <div class="profile-card">
          <div class="profile-grid">
            <div class="profile-row"><span class="profile-key">Model</span><span class="profile-val">Claude Sonnet 4.6</span></div>
            <div class="profile-row"><span class="profile-key">Family</span><span class="profile-val">Claude 4.6</span></div>
            <div class="profile-row"><span class="profile-key">Developer</span><span class="profile-val"><a href="https://www.anthropic.com" target="_blank" rel="noopener">Anthropic</a></span></div>
            <div class="profile-row"><span class="profile-key">Interface</span><span class="profile-val">Claude.ai</span></div>
            <div class="profile-row"><span class="profile-key">Nickname</span><span class="profile-val">そねち / sonech</span></div>
          </div>
        </div>
      </div>

      <!-- Role in site -->
      <div class="about-section">
        <h2 class="section-label">Role in this site</h2>
        <div class="role-grid">
          <div class="role-card">
            <h3 class="role-title">HTML / CSS / JavaScript</h3>
            <p class="role-desc">スタイル・レイアウト設計。レスポンシブデザイン、ライト／ダークモード対応。桃色×チャコールのカラーシステム構築。</p>
          </div>
          <div class="role-card">
            <h3 class="role-title">デプロイ・自動化</h3>
            <p class="role-desc">Node.jsスクリプトによるposts.json生成、marked.jsでのHTML変換、WebP自動変換、sitemap・RSS・OGP自動生成。</p>
          </div>
          <div class="role-card">
            <h3 class="role-title">サイト設計</h3>
            <p class="role-desc">静的サイト構成、タグフィルター・前後ナビ・天気取得など各種機能の設計と実装。</p>
          </div>
          <div class="role-card">
            <h3 class="role-title">コンテンツ管理</h3>
            <p class="role-desc">フォルダ構成設計（blog/[tag]/**.md）、_index.mdスキップ、予約投稿対応。</p>
          </div>
        </div>
      </div>

      <!-- History -->
      <div class="about-section">
        <h2 class="section-label">Site History</h2>
        <div class="sonech-card prose-text">
          <p>当サイトはいくつかの転換点を経て現在の形になっています。</p>
          <p>当初はカスタムCMS（AirPubre）とGitHub、シンフリーサーバーを組み合わせた構成でしたが、2026年春、GitHub + Vercelベースへ移行。一時期Hugoを導入したのち、独自のNode.jsパイプラインを構築しました。</p>
          <p>そして2026年5月、さらなる表現の自由度と運用の効率化を求め、Astro + Sanity CMSによるヘッドレス構成へとフルリニューアルを果たしました。100記事を超えるアーカイブの完全な継承と、ブラウザベースの快適な執筆環境、そして極限まで無駄を削ぎ落としたソリッドなデザインを、Claudeとの対話を通じて形にしました。</p>
        </div>
      </div>

      <!-- Anthropic Info -->
      <div class="about-section">
        <h2 class="section-label">About Anthropic</h2>
        <div class="sonech-card prose-text">
          <p>AnthropicはAIの安全性研究を中心に据えたAI企業です。有害なコンテンツの生成を防ぐための安全対策（セーフガード）を重視しており、信頼性の高いAIシステムの開発を目標としています。</p>
          <p>詳細は<a href="https://www.anthropic.com" target="_blank" rel="noopener">anthropic.com</a>をご参照ください。</p>
        </div>
      </div>

      <p class="about-footnote">このページはサイト運営者（Shun Tonegawa）が手動で管理しています。掲載情報はサイト制作時点のものであり、モデルの仕様等は予告なく変更される場合があります。</p>
    </section>

  </div>
</Layout>

<style>
  /* ── Layout & Wrapper ── */
  .about-wrap {
    padding-top: 3.5rem;
    padding-bottom: 8rem;
  }

  /* ── Premium Tab Switcher ── */
  .about-tabs {
    display: flex;
    gap: 0;
    border-bottom: 1px solid var(--border);
    margin-bottom: 3.5rem;
  }

  .about-tab-btn {
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    padding: 0.8rem 1.8rem;
    font-family: var(--font-sans);
    font-size: 0.76rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-subtle);
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .about-tab-btn:hover {
    color: var(--text);
  }

  .about-tab-btn.active {
    color: var(--accent);
    border-bottom-color: var(--accent);
    font-weight: 600;
  }

  /* Tab panels visibility */
  .about-panel {
    display: none;
    animation: fadeIn 0.5s ease both;
  }

  .about-panel.active {
    display: block;
  }

  /* ── Card Styling ── */
  .about-section {
    margin-bottom: 3rem;
  }

  .profile-card, .names-card, .contact-card, .sonech-card {
    background: var(--surface);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.8rem;
    box-shadow: var(--shadow);
  }

  /* Parameter Tables (Me Profile) */
  .profile-grid {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--border);
    margin-bottom: 1.2rem;
  }

  .profile-row {
    display: flex;
    align-items: baseline;
    gap: 1.5rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--border);
    font-size: 0.88rem;
  }

  .profile-key {
    font-size: 0.64rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-subtle);
    width: 90px;
    flex-shrink: 0;
  }

  .profile-val {
    color: var(--text-muted);
    font-weight: 400;
  }

  .profile-val a {
    color: var(--accent);
    border-bottom: 1px solid rgba(var(--accent-rgb), 0.2);
  }

  .profile-val a:hover {
    border-bottom-color: var(--accent);
  }

  .profile-bio {
    font-size: 0.86rem;
    color: var(--text-muted);
    line-height: 1.8;
  }

  /* Names catalog styles */
  .names-grid {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--border);
  }

  .name-row {
    display: flex;
    gap: 2rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--border);
    align-items: flex-start;
  }

  .name-category {
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-subtle);
    width: 100px;
    flex-shrink: 0;
    padding-top: 0.2rem;
    opacity: 0.8;
  }

  .name-values {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex: 1;
  }

  .name-item {
    font-size: 0.88rem;
    color: var(--text-muted);
    font-weight: 400;
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .name-item a {
    color: inherit;
    border-bottom: 1px solid rgba(var(--text-muted), 0.1);
  }

  .name-item a:hover {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }

  .name-en {
    font-size: 0.76rem;
    color: var(--text-subtle);
    font-weight: 300;
  }

  .name-desc {
    font-size: 0.68rem;
    color: var(--text-subtle);
    opacity: 0.85;
  }

  .name-badge {
    font-size: 0.58rem;
    font-weight: 600;
    color: var(--accent);
    background: rgba(var(--accent-rgb), 0.06);
    padding: 0.08rem 0.35rem;
    border-radius: var(--radius-sm);
  }

  .names-footnote {
    font-size: 0.72rem;
    color: var(--text-subtle);
    margin-top: 1rem;
    opacity: 0.75;
  }

  /* Contact addresses styling */
  .contact-item {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .contact-label {
    font-size: 0.86rem;
    font-weight: 500;
    color: var(--text);
  }

  .contact-desc {
    font-size: 0.72rem;
    color: var(--text-subtle);
    line-height: 1.6;
  }

  .contact-reveal-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: none;
    border: 1px solid var(--border-mid);
    border-radius: 999px;
    padding: 0.4rem 1.2rem;
    font-family: var(--font-sans);
    font-size: 0.7rem;
    color: var(--text-subtle);
    cursor: pointer;
    transition: all 0.3s ease;
    width: fit-content;
    margin-top: 0.5rem;
  }

  .contact-reveal-btn:hover {
    color: var(--accent);
    border-color: var(--accent);
    box-shadow: 0 4px 10px rgba(var(--accent-rgb), 0.15);
  }

  .contact-revealed-wrap {
    display: none;
    align-items: center;
    gap: 0.8rem;
    flex-wrap: wrap;
    margin-top: 0.5rem;
    animation: fadeIn 0.4s ease both;
  }

  .contact-revealed-wrap.open {
    display: flex;
  }

  .contact-email {
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--accent);
    font-family: 'SF Mono', 'Fira Code', monospace;
  }

  .contact-copy-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    background: none;
    border: 1px solid var(--border-mid);
    border-radius: 999px;
    padding: 0.25rem 0.8rem;
    font-family: var(--font-sans);
    font-size: 0.65rem;
    color: var(--text-subtle);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .contact-copy-btn:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  /* ── Links tab layout ── */
  .links-list {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--border);
  }

  .link-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--border);
  }

  .link-item a {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    flex: 1;
  }

  .link-title {
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--text);
  }

  .link-item:hover .link-title {
    color: var(--accent);
  }

  .link-note {
    font-size: 0.72rem;
    color: var(--text-subtle);
    font-weight: 300;
  }

  .link-arrow {
    font-size: 0.85rem;
    color: var(--text-subtle);
    opacity: 0.4;
    transition: all 0.2s ease;
  }

  .link-item:hover .link-arrow {
    opacity: 1;
    color: var(--accent);
    transform: translate(2px, -2px);
  }

  /* ── Sonech tab layout ── */
  .prose-text p {
    font-size: 0.88rem;
    color: var(--text-muted);
    line-height: 1.95;
    margin-bottom: 1.2rem;
  }

  .prose-text p:last-child {
    margin-bottom: 0;
  }

  .role-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .role-card {
    background: var(--surface);
    backdrop-filter: blur(12px);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.5rem;
    box-shadow: var(--shadow);
  }

  .role-title {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 0.5rem;
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.4rem;
  }

  .role-desc {
    font-size: 0.76rem;
    color: var(--text-muted);
    line-height: 1.8;
  }

  .about-footnote {
    font-size: 0.72rem;
    color: var(--text-subtle);
    opacity: 0.65;
    margin-top: 3rem;
    line-height: 1.6;
  }

  /* Responsive tab layout adjustment */
  @media (max-width: 640px) {
    .about-tab-btn {
      padding: 0.8rem 1rem;
      font-size: 0.7rem;
    }
    .name-row {
      flex-direction: column;
      gap: 0.4rem;
    }
    .name-category {
      width: auto;
    }
  }
</style>

<!-- Client Hydration for About Tab switches and Email Reveal -->
<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    // ── Tab Toggles ──
    const tabs = document.querySelectorAll('.about-tab-btn');
    const panels = document.querySelectorAll('.about-panel');

    const switchTab = (tabName) => {
      tabs.forEach(tab => {
        const active = tab.getAttribute('data-tab') === tabName;
        tab.classList.toggle('active', active);
        tab.setAttribute('aria-selected', active);
      });

      panels.forEach(panel => {
        panel.classList.toggle('active', panel.id === `panel-${tabName}`);
      });

      // Update URL query string silently without page refresh
      const newUrl = tabName === 'me' ? '/about/' : `/about/?tab=${tabName}`;
      history.replaceState(null, '', newUrl);
    };

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const tabName = tab.getAttribute('data-tab');
        switchTab(tabName);
      });
    });

    // Check URL parameters on load
    const urlTab = new URLSearchParams(location.search).get('tab');
    if (urlTab && ['me', 'links', 'sonech'].includes(urlTab)) {
      switchTab(urlTab);
    }

    // ── Email Revealer ──
    const revealBtn = document.getElementById('reveal-email-btn');
    const emailWrap = document.getElementById('email-revealed-wrap');
    const copyBtn = document.getElementById('copy-email-btn');

    if (revealBtn && emailWrap) {
      revealBtn.addEventListener('click', () => {
        revealBtn.style.display = 'none';
        emailWrap.classList.add('open');
      });
    }

    if (copyBtn) {
      copyBtn.addEventListener('click', () => {
        const email = copyBtn.getAttribute('data-email');
        navigator.clipboard.writeText(email).then(() => {
          const originalText = copyBtn.innerHTML;
          copyBtn.innerHTML = '✓ コピーしました';
          copyBtn.style.color = 'var(--accent)';
          copyBtn.style.borderColor = 'var(--accent)';

          setTimeout(() => {
            copyBtn.innerHTML = originalText;
            copyBtn.style.color = '';
            copyBtn.style.borderColor = '';
          }, 2000);
        }).catch(err => {
          console.error('Failed to copy email:', err);
        });
      });
    }
  });
</script>
